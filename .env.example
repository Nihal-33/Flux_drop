# FluxDrop Environment Configuration
PORT=5000
NODE_ENV=development

# Authentication & Encryption Secrets
AUTH_SECRET=fluxdrop-super-secure-jwt-secret-key-32-chars-min!
PIN_SECRET=fluxdrop-pin-hmac-salt-secret-994200
DOWNLOAD_URL_SECRET=fluxdrop-signed-urls-secure-token-2026

# Storage Settings
STORAGE_TYPE=local # 'local' | 's3' | 'supabase'
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE=5368709120 # 5GB

# Database (Supports Local Persisted JSON or PostgreSQL)
DATABASE_URL=file:./data/fluxdrop_db.json

# CORS
CLIENT_URL=http://localhost:5173
